{
  "name": "mittelstand-target-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "bash scripts/with-local-supabase.sh npm run dev",
    "dev:sites": "vinext dev",
    "db:local:start": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:local:reset": "supabase db reset --local",
    "check:connections": "node --env-file=.env.local scripts/check-provider-connections.mjs",
    "check:data": "node --env-file=.env.local scripts/check-provider-data.mjs",
    "check:data:openregister": "node --env-file=.env.local scripts/check-openregister-data.mjs",
    "check:filters:openregister": "node --env-file=.env.local scripts/check-openregister-filters.mjs",
    "test:discovery:10": "node --env-file=.env.local scripts/run-openregister-test-search.mjs",
    "verify:providers": "bash scripts/with-local-supabase.sh node --env-file=.env.local scripts/verify-live-providers.mjs",
    "build": "next build",
    "build:sites": "vinext build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:rls": "supabase start --exclude realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor && node scripts/verify-rls-local.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "8.1.3",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/workers-types": "5.20260902.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "type": "module"
}
